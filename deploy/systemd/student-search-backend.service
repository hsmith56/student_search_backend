[Unit]
Description=Student Search Backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=harrison
Group=harrison
WorkingDirectory=/home/harrison/student_search_backend
Environment=PATH=/home/harrison/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/harrison/.local/bin/uv run fastapi run
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
