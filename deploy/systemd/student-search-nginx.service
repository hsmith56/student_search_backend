[Unit]
Description=Student Search Nginx (custom config)
After=network-online.target student-search-backend.service student-search-frontend.service
Wants=network-online.target student-search-backend.service student-search-frontend.service

[Service]
Type=simple
ExecStart=/usr/sbin/nginx -c /home/harrison/student_search_backend/nginx_unix.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -s reload -c /home/harrison/student_search_backend/nginx_unix.conf
ExecStop=/usr/sbin/nginx -s quit -c /home/harrison/student_search_backend/nginx_unix.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
