[Unit]
Description=Student Search Frontend (npm start)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=harrison
Group=harrison
WorkingDirectory=/home/harrison/student_search_frontend
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
